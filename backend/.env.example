# ============================================================
# CyberZeus AMS — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production

# ── Security ─────────────────────────────────────────────────
# Change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret_key_at_least_32_chars
JWT_EXPIRE_HOURS=12

# ── Office Network Restriction ────────────────────────────────
# Set to true to block requests from outside 192.168.100.x subnet
ENFORCE_SUBNET=false
